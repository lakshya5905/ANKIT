rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidProperty(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 3000 &&
             data.propertyType is string &&
             data.price is number && data.price >= 0 &&
             data.location is string && data.location.size() <= 150 &&
             data.status in ['Available', 'Under Offer', 'Sold'] &&
             data.images is list && data.images.size() <= 20;
    }

    function isValidEnquiry(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 25 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.status in ['New', 'Contacted', 'Closed'];
    }

    function isValidSettings(data) {
      return data.businessName is string && data.businessName.size() <= 150 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.whatsapp is string && data.whatsapp.size() <= 30 &&
             data.email is string && data.email.size() <= 150;
    }

    // Properties: Public can read listings; Valid property listings can be created/managed
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update: if isValidId(propertyId) && isValidProperty(request.resource.data);
      allow delete: if isValidId(propertyId);
    }

    // Enquiries: Public can submit; Leads can be viewed and managed
    match /enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) && isValidEnquiry(request.resource.data);
      allow read, update, delete: if isValidId(enquiryId);
    }

    // Settings: Public can read business contact info; Valid settings can be saved
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isValidId(settingsId) && isValidSettings(request.resource.data);
    }
  }
}
